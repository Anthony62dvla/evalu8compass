# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=3000
HOST=127.0.0.1             # keep this on a shared VPS: only your web server (nginx/Caddy) can reach the app

# Workshops
MIN_GROUP_SIZE=3            # role breakdowns hidden for smaller groups (anonymity)
MAX_PARTICIPANTS=300        # per workshop
SESSION_RETENTION_DAYS=90   # workshop records deleted after this many days without activity

# Abuse protection
RATE_LIMIT_PER_MIN=20       # AI calls per IP per minute
API_LIMIT_PER_MIN=600       # other API calls per IP per minute (a whole staffroom may share one school IP)
TRUST_PROXY=0               # set to 1 behind nginx/Caddy/Cloudflare so limits use the real client IP

# Saved school work
SCHOOL_RETENTION_DAYS=365   # saved self-evaluations deleted this many days after a school's access ends

# Policy pages (privacy notice, terms, DPIA information). Leave blank for neutral wording.
OPERATOR_NAME=              # who provides the service, e.g. your name or company: "Jane Smith" or "Evalu8 Compass Ltd"
OPERATOR_ADDRESS=           # optional postal address (a company's registered office)
ICO_REGISTRATION=           # ICO data protection fee registration number, e.g. ZB123456
HOSTING_REGION=             # where the VPS is, from hPanel, e.g. "the United Kingdom" or "Lithuania (EU)"
BACKUP_PROVIDER=            # off-site backup provider, e.g. "Backblaze (EU region)"
EMAIL_PROVIDER=             # who hosts support@ mail, e.g. "Hostinger"
