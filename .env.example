# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=     # only if your key isn't scoped to a workspace: the wrkspc_... ID from Console → Settings → Workspaces
# Optional
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=3000
HOST=127.0.0.1             # keep this on a shared VPS: only your web server (nginx/Caddy) can reach the app

# Workshops
MIN_GROUP_SIZE=3            # role breakdowns hidden for smaller groups (anonymity)
MAX_PARTICIPANTS=300        # per workshop
SESSION_RETENTION_DAYS=90   # workshop records deleted after this many days without activity

# AI allowance (per school, per calendar month, UK time)
AI_MONTHLY_REQUESTS=200     # AI requests each school can make a month; change per school in the admin console. "unlimited" for no cap
AI_PRICE_INPUT_PER_MTOK=    # optional: your model's price per million input tokens, to show estimated cost in the admin console
AI_PRICE_OUTPUT_PER_MTOK=   # optional: price per million output tokens
AI_PRICE_CURRENCY=$
AI_TOPUP_PACKS=50:10,150:25,400:60   # extra AI requests schools can buy when 10 or fewer are left: requests:price in £, comma-separated

# Abuse protection
RATE_LIMIT_PER_MIN=20       # AI calls per IP per minute
API_LIMIT_PER_MIN=600       # other API calls per IP per minute (a whole staffroom may share one school IP)
TRUST_PROXY=0               # set to 1 behind nginx/Caddy/Cloudflare so limits use the real client IP

# Saved school work
SCHOOL_RETENTION_DAYS=365   # saved self-evaluations deleted this many days after a school's access ends

# Policy pages (privacy notice, terms, DPIA information). Leave blank for neutral wording.
OPERATOR_NAME=              # who provides the service, e.g. your name or company: "Jane Smith" or "Evalu8 Compass Ltd"
OPERATOR_ADDRESS=           # optional postal address (a company's registered office)
ICO_REGISTRATION=           # ICO data protection fee registration number, e.g. ZB123456
HOSTING_REGION=             # where the VPS is, from hPanel, e.g. "the United Kingdom" or "Lithuania (EU)"
BACKUP_PROVIDER=            # off-site backup provider, e.g. "Backblaze (EU region)"
EMAIL_PROVIDER=             # who hosts support@ mail, e.g. "Hostinger"

# Sign-up, email and invoices (see deploy/DEPLOY.md, "Sign-up, email and invoices")
SITE_URL=https://evalu8compass.app
SMTP_HOST=                  # Hostinger email: smtp.hostinger.com
SMTP_PORT=465               # 465 = SSL. Use 587 for STARTTLS
SMTP_USER=                  # the mailbox, e.g. support@evalu8compass.app
SMTP_PASS=                  # that mailbox's password (never share it)
MAIL_FROM=Evalu8 Compass <support@evalu8compass.app>
ADMIN_EMAIL=                # where sign-up, subscription and trust enquiry notifications go (defaults to MAIL_FROM)
# Shown on invoices. Invoices are only sent automatically once OPERATOR_NAME and the bank details are set.
BANK_ACCOUNT_NAME=          # name on the account, if different from OPERATOR_NAME
BANK_NAME=                  # optional, e.g. "Starling Bank"
BANK_SORT_CODE=             # e.g. 12-34-56
BANK_ACCOUNT_NUMBER=        # e.g. 12345678
VAT_NUMBER=                 # leave blank until you're VAT registered: then invoices add VAT
VAT_RATE=20

# Consultant register
POSTCODES_API=https://api.postcodes.io   # postcode lookups for distance search (free, no key)
